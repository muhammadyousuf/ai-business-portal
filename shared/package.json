{
  "name": "@assistflow/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Design system (tokens, primitives, layout), utils, status maps, domain types and temporary mock fixtures shared by the admin and user apps.",
  "type": "module",
  "exports": {
    "./ui/*": "./src/ui/*.tsx",
    "./components/*": "./src/components/*.tsx",
    "./layout/*": "./src/layout/*.tsx",
    "./dashboard/*": "./src/dashboard/*.tsx",
    "./lib/*": "./src/lib/*.ts",
    "./mock/*": "./src/mock/*.ts",
    "./styles/*": "./src/styles/*"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "echo 'linted by consuming apps'"
  },
  "peerDependencies": {
    "next": "15.5.28",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "dependencies": {
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-progress": "^1.2.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.66.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "next": "15.5.28",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "typescript": "^5"
  }
}
