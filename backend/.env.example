PORT=4000
NODE_ENV=development
# Local dev: mongodb://127.0.0.1:27017/ai-business-portal (brew services start mongodb-community).
# Leave empty to run with in-memory fixtures (no database).
MONGODB_URI=
# Comma-separated origins allowed to call the portal APIs (admin + user apps).
PORTAL_ORIGINS=http://localhost:3000,http://localhost:3001
# Bot requests are allowed from each business's registered website origins (stored per business),
# plus these dev origins.
BOT_DEV_ORIGINS=http://localhost:5173
# AI provider (unused until the AI service is wired).
AI_PROVIDER=anthropic
AI_API_KEY=

# Supabase (auth only)
SUPABASE_URL=
SUPABASE_JWKS_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PUBLISHABLE_KEY=
USER_APP_URL=http://localhost:3000
ADMIN_APP_URL=http://localhost:3001
API_PUBLIC_URL=http://localhost:4000
# Files: Cloudinary when set, local disk (UPLOAD_DIR) otherwise
# CLOUDINARY_URL=cloudinary://<key>:<secret>@<cloud>
UPLOAD_DIR=uploads
MONGODB_TEST_URI=mongodb://127.0.0.1:27017/ai-business-portal-test
# Optional: legacy JWT secret (Project Settings -> JWT Keys). With it, HS256 tokens verify locally; without it the backend asks Supabase (cached 2 min).
SUPABASE_JWT_SECRET=
